{
  "name": "@dsh-fly/dsh-plugin-fly-smart",
  "version": "0.3.0",
  "description": "Fly smart：模型路由面板（hand / review）+ smart_dispatch / smart_check_doc 两个工具 + 10 个独立技能。0.3.0 删除了三模型工作流（阶段机 / 用户门 / 任务树面板）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "index.js",
    "panel/routes.mjs",
    "lib/dispatch.mjs",
    "lib/doc-contract.mjs",
    "lib/client.js",
    "tools",
    "cordis.patch.yml",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "verify": "node scripts/verify-smart.mjs",
    "test": "node --test tests/*.spec.mjs panel/tests/*.spec.mjs",
    "build:client": "node scripts/build-client.mjs",
    "identity": "node scripts/check-commit-identity.mjs --all"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.1.0 || >=4.1.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.19.0 || >=3.19.0-rc.1 <4.0.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-plugin-fly-smart.git"
  },
  "homepage": "https://github.com/ethanchen669/dsh-plugin-fly-smart#readme",
  "bugs": {
    "url": "https://github.com/ethanchen669/dsh-plugin-fly-smart/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@dsh-fly/fly-panel-style": "^0.1.0",
    "js-yaml": "^5.5.0",
    "vite": "^5.4.21"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
